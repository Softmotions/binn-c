cc {
  set { _
    perf001.c
   }
  ${CFLAGS_TESTS}
}

foreach {
  OBJ
  ${CC_OBJS}
  run {
    exec { ${CC} ${OBJ} ${LDFLAGS_TEST} -o %{${OBJ}} }
    consumes { ${LIBBINNC_A} ${OBJ} }
    produces { %{${OBJ}} }
  }
}

if { ${BINNC_RUN_PERF}
  foreach {
    OBJ
    ${CC_OBJS}
    run {
      always
      shell { %{${OBJ}} }
      consumes { %{${OBJ}} }
    }
  }
}
